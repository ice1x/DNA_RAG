# DNA RAG Configuration
# Copy to .env and fill in your values.

# ---------------------------------------------------------------------------
# Primary LLM (used for SNP identification + default for interpretation)
# ---------------------------------------------------------------------------

# Required -- your LLM provider API key.
DNA_RAG_LLM_API_KEY=your-api-key-here

# Provider: deepseek | openai_compat
DNA_RAG_LLM_PROVIDER=deepseek
DNA_RAG_LLM_MODEL=deepseek-r1:free
DNA_RAG_LLM_BASE_URL=https://api.deepseek.com/v1

# Uncomment below for OpenAI (or any OpenAI-compatible API):
# DNA_RAG_LLM_PROVIDER=openai_compat
# DNA_RAG_LLM_MODEL=gpt-4o-mini
# DNA_RAG_LLM_BASE_URL=https://api.openai.com/v1

DNA_RAG_LLM_TEMPERATURE=0.0
DNA_RAG_LLM_MAX_RETRIES=3
DNA_RAG_LLM_TIMEOUT=60.0

# ---------------------------------------------------------------------------
# Interpretation LLM (optional -- falls back to primary if not set)
# ---------------------------------------------------------------------------

# DNA_RAG_LLM_INTERP_PROVIDER=openai_compat
# DNA_RAG_LLM_INTERP_API_KEY=sk-your-openai-key
# DNA_RAG_LLM_INTERP_MODEL=gpt-4o-mini
# DNA_RAG_LLM_INTERP_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
DNA_RAG_CACHE_BACKEND=memory
DNA_RAG_CACHE_MAX_SIZE=1000
DNA_RAG_CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Medical Disclaimer (appended to every LLM interpretation, translated to response language)
# ---------------------------------------------------------------------------
# DNA_RAG_MEDICAL_DISCLAIMER=Disclaimer: This analysis is for educational and research purposes only. Genetic predisposition is not deterministic. Consult a qualified healthcare provider for medical interpretation.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
DNA_RAG_LOG_LEVEL=INFO
DNA_RAG_LOG_FORMAT=console
