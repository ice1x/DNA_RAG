# DNA RAG Configuration
# Copy to .env and fill in your values.

# Required -- your LLM provider API key.
DNA_RAG_LLM_API_KEY=your-api-key-here

# LLM Provider: deepseek | openai_compat
DNA_RAG_LLM_PROVIDER=deepseek
DNA_RAG_LLM_MODEL=deepseek-r1:free
DNA_RAG_LLM_BASE_URL=https://api.deepseek.com/v1
DNA_RAG_LLM_TEMPERATURE=0.0
DNA_RAG_LLM_MAX_RETRIES=3
DNA_RAG_LLM_TIMEOUT=60.0

# Cache: memory | none
DNA_RAG_CACHE_BACKEND=memory
DNA_RAG_CACHE_MAX_SIZE=1000
DNA_RAG_CACHE_TTL_SECONDS=3600

# Logging
DNA_RAG_LOG_LEVEL=INFO
DNA_RAG_LOG_FORMAT=console
