# DNA_RAG Configuration
# Copy this file to .env and fill in your values

# ==========================================
# API Keys (REQUIRED)
# ==========================================
# DeepSeek API key - Get yours at https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Backward compatibility: API_KEY is also supported
# API_KEY=your_deepseek_api_key_here

# ==========================================
# SNP Database Settings
# ==========================================
# Cache TTL in seconds (default: 3600 = 1 hour)
DNA_RAG_CACHE_TTL=3600

# Maximum number of SNPs to cache (default: 1000)
DNA_RAG_MAX_CACHE_SIZE=1000

# HTTP request timeout in seconds (default: 10.0)
DNA_RAG_REQUEST_TIMEOUT=10.0

# ==========================================
# Vector Store Settings
# ==========================================
# Path to vector store directory (default: ./data/vector_store)
DNA_RAG_VECTOR_STORE_PATH=./data/vector_store

# Sentence transformer model for embeddings (default: all-MiniLM-L6-v2)
# Other options: all-mpnet-base-v2, paraphrase-MiniLM-L6-v2
DNA_RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Enable vector store for RAG (default: true)
DNA_RAG_USE_VECTOR_STORE=true

# ==========================================
# Validation Settings
# ==========================================
# Enable SNP validation through dbSNP API (default: true)
DNA_RAG_USE_VALIDATION=true

# ==========================================
# LLM Settings
# ==========================================
# LLM model name (default: deepseek-r1:free)
DNA_RAG_LLM_MODEL=deepseek-r1:free

# LLM temperature 0.0-2.0 (default: 0.0)
# Higher = more creative, Lower = more deterministic
DNA_RAG_LLM_TEMPERATURE=0.0

# LLM maximum retry attempts (default: 2)
DNA_RAG_LLM_MAX_RETRIES=2
